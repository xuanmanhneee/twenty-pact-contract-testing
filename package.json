{
  "name": "twenty-pact-i01",
  "private": true,
  "type": "module",
  "scripts": {
    "test:consumer": "rimraf pacts && vitest run tests/consumer.test.js",
    "test:provider": "vitest run tests/provider.verify.test.js",
    "break:rename-field": "rimraf pacts && cross-env BREAK=1 vitest run tests/consumer.test.js && vitest run tests/provider.verify.test.js",
    "proxy": "node tests/rename-proxy.mjs",
    "test:provider:proxy": "cross-env TWENTY_URL=http://localhost:4001 vitest run tests/provider.verify.test.js",
    "auth-proxy": "node tests/auth-proxy.mjs"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.0.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.0",
    "vitest": "^3.0.0"
  }
}